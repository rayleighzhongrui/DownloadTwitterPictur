{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "48": "images/icon.png"
  },
  "permissions": ["downloads", "declarativeNetRequest", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://*.pixiv.net/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_icon": "images/icon.png",
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "host_permissions": [
    "*://*.pixiv.net/*",
    "*://i.pximg.net/*",
    "*://pixiv.zhongrui.app/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
